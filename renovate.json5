{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // This is a definitions catalogue, not an app: the only things worth
  // tracking are the pins inside image/*/image.yaml. Disable every built-in
  // manager and drive everything from the two custom regex managers below,
  // so Renovate never opens surprise PRs for unrelated ecosystems.
  // (When phase 6 adds test/ as a Go module, enable "gomod" here too.)
  enabledManagers: ["custom.regex"],

  dependencyDashboard: true,
  // Keep the frontend/builder digests fresh (Req 1.2); the docker manager
  // needs them to detect digest drift.
  pinDigests: true,
  // Always rebase an open bump PR when main advances. Renovate's default only
  // rebases conflicted PRs, so a PR could sit behind main with stale CI (e.g.
  // after a test/tooling change) and never go green until manually rebased.
  rebaseWhen: "behind-base-branch",

  customManagers: [
    {
      // Upstream source: the single version knob. `url: git+https://…#vX.Y.Z`
      // is the source of truth; derived vars/tags/ldflags/checksum are
      // regenerated by postUpgradeTasks (task 4.2). github-tags covers both
      // an app with only tags (hardened-app) and one with Releases
      // (cert-manager) — Releases are a subset of tags.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        "url:\\s*[\"']?git\\+https://github\\.com/(?<depName>[^/]+/[^/.]+?)(?:\\.git)?#(?<currentValue>v?[0-9][^\\s\"']*)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      // dhc build layer: the DHI frontend and golang builder, pinned by
      // tag@digest in three spots (# syntax=, uses:, GOLANG_REFERENCE var).
      // Resolving digests needs dhi.io credentials, injected by the cron
      // (task 4.2); the config itself is valid without them.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        "syntax=(?<depName>dhi\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "uses:\\s*(?<depName>dhi\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "GOLANG_REFERENCE:\\s*(?<depName>dhi\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Grafana is the tarball-repackage archetype: it ships a prebuilt
      // release from dl.grafana.com, so there is no `git+https://…#vX.Y.Z`
      // ref for the source manager above to latch onto and Renovate tracked
      // nothing but its build layer. Read the version straight out of the
      // download url and resolve it against upstream's GitHub Releases — the
      // download host and the version datasource are separate concerns
      // (ADR 0002: GitHub carries no linux tarball, only .deb/.rpm and a
      // source archive, so the url itself must stay on dl.grafana.com).
      // github-releases rather than github-tags is deliberate: it keeps
      // grafana out of the git-source packageRules below, whose
      // postUpgradeTask resolves a commit sha grafana does not have.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        "url:\\s*https://dl\\.grafana\\.com/oss/release/grafana-(?<currentValue>[0-9][^\\s\"'/]*?)\\.linux-",
      ],
      depNameTemplate: "grafana/grafana",
      datasourceTemplate: "github-releases",
      // Our pin is unprefixed (13.0.4); upstream tags its releases v13.0.4.
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
  ],

  packageRules: [
    {
      // Req 3.3: the three cert-manager images share one upstream monorepo —
      // group their bumps into a single PR so one version moves all of them.
      matchDepNames: ["cert-manager/cert-manager"],
      groupName: "cert-manager monorepo",
    },
    {
      // Req 3.4: a new major stages behind Dependency Dashboard approval
      // instead of opening an automatic PR.
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Req 3.5: digest-only and patch updates of an upstream source automerge,
      // gated on CI success (Renovate withholds merge until checks pass).
      matchDatasources: ["github-tags"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    {
      // Req 3.2: Renovate bumps only the source ref; this recomputes the
      // checksum and regenerates every version-derived field (vars, tags,
      // ldflags) so the bumped definition is coherent. Scoped to github-tags
      // so docker digest bumps don't trigger it. The command is allowlisted in
      // renovate.yml via RENOVATE_ALLOWED_POST_UPGRADE_COMMANDS (self-hosted).
      matchDatasources: ["github-tags"],
      postUpgradeTasks: {
        commands: ["scripts/refresh-definition.sh {{{packageFileDir}}}"],
        fileFilters: ["image/**/image.yaml"],
        executionMode: "update",
      },
    },
    {
      // The repackage counterpart (ADR 0002): Renovate bumps only the version
      // inside the tarball url, so this re-pins both per-arch checksums from
      // dl.grafana.com and regenerates the version-derived fields. Scoped to
      // github-releases, which only grafana uses. Allowlisted alongside
      // refresh-definition.sh in renovate.yml.
      matchDatasources: ["github-releases"],
      postUpgradeTasks: {
        commands: ["scripts/refresh-grafana.sh {{{packageFileDir}}}"],
        fileFilters: ["image/**/image.yaml"],
        executionMode: "update",
      },
      // Explicit, though the Req 3.5 automerge rule above is github-tags-only:
      // a repackage bump swaps a binary artifact we did not build and re-pins
      // its checksum, so it is always reviewed even on a patch.
      automerge: false,
    },
    {
      // The build layer is our own stricter pin surface — a frontend/builder
      // change alters build behavior, so it is always reviewed, never merged
      // automatically. Grouped for a tidy dashboard.
      matchDatasources: ["docker"],
      matchPackageNames: ["dhi.io/build", "dhi.io/golang"],
      groupName: "dhi.io build layer",
      automerge: false,
    },
  ],
}
