{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // This is a definitions catalogue, not an app: the only things worth
  // tracking are the pins inside image/*/image.yaml. Disable every built-in
  // manager and drive everything from the two custom regex managers below,
  // so Renovate never opens surprise PRs for unrelated ecosystems.
  // (When phase 6 adds test/ as a Go module, enable "gomod" here too.)
  enabledManagers: ["custom.regex"],

  dependencyDashboard: true,
  // Keep the frontend/builder digests fresh (Req 1.2); the docker manager
  // needs them to detect digest drift.
  pinDigests: true,
  // Always rebase an open bump PR when main advances. Renovate's default only
  // rebases conflicted PRs, so a PR could sit behind main with stale CI (e.g.
  // after a test/tooling change) and never go green until manually rebased.
  rebaseWhen: "behind-base-branch",
  // Renovate creates no new branch once this many exist (branchConcurrentLimit
  // inherits it; both default to 10). Ten open bumps is this catalogue's
  // steady state: tool minors staging behind their gates, digest pins, the
  // tracked grafana minor. Measured 2026-09-02: at exactly ten, the 13.1.5
  // security patch was skipped silently on every run ("Reached branch limit").
  prConcurrentLimit: 20,

  // The tracking scope (Req 1.14, 3.2, 3.11; task 14.2). Renovate cannot read
  // catalogue-policy.yaml, so scripts/render-tracking.sh renders its active
  // set here as ignorePaths: one glob per inactive definition directory and
  // per chart directory deploying no active definition, so no bump opens for
  // a frozen definition. Every path is skipped before any manager reads it
  // (measured on 41.173.1). Empty while everything is active, the reference
  // instance's state. Do not edit between the markers: validate fails on
  // drift (Req 7.9); edit the active set or a chart's deploys list and
  // re-render.
  // render-tracking:begin
  ignorePaths: [],
  // render-tracking:end

  customManagers: [
    {
      // Upstream source: the single version knob. `url: git+https://…#vX.Y.Z`
      // is the source of truth; derived vars/tags/ldflags/checksum are
      // regenerated by postUpgradeTasks (task 4.2). github-tags covers both
      // an app with only tags (hardened-app) and one with Releases
      // (cert-manager) — Releases are a subset of tags.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        "url:\\s*[\"']?git\\+https://github\\.com/(?<depName>[^/]+/[^/.]+?)(?:\\.git)?#(?<currentValue>v?[0-9][^\\s\"']*)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      // dhc build layer: the DHI frontend and golang builder, pinned by
      // tag@digest in three spots (# syntax=, uses:, GOLANG_REFERENCE var).
      // Resolving digests needs dhi.io credentials, injected by the cron
      // (task 4.2); the config itself is valid without them.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        "syntax=(?<depName>dhi\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "uses:\\s*(?<depName>dhi\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "GOLANG_REFERENCE:\\s*(?<depName>dhi\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Grafana is the tarball-repackage archetype: it ships a prebuilt
      // release from dl.grafana.com, so there is no `git+https://…#vX.Y.Z`
      // ref for the source manager above to latch onto and Renovate tracked
      // nothing but its build layer. Read the version straight out of the
      // download url and resolve it against upstream's GitHub Releases — the
      // download host and the version datasource are separate concerns
      // (ADR 0002: GitHub carries no linux tarball, only .deb/.rpm and a
      // source archive, so the url itself must stay on dl.grafana.com).
      // github-releases rather than github-tags is deliberate: it keeps
      // grafana out of the git-source packageRules below, whose
      // postUpgradeTask resolves a commit sha grafana does not have.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        // The per-build artifact, which is what we pin: the version is the path
        // segment. Renovate turns that one knob; refresh-grafana.sh resolves the
        // matching build id and rebuilds the whole url. That resolution reads
        // the grafana.com versions API, apt.grafana.com AND this release,
        // cross-checked — 13.1.2 and 13.1.3 both published with zero GitHub
        // assets and no apt entry while the API carried the id (ADR 0002,
        // amendments 2026-08-07 and 2026-08-11).
        "url:\\s*https://dl\\.grafana\\.com/grafana/release/(?<currentValue>[0-9][^\\s\"'/]*)/",
        // Only the per-build shape. The legacy /oss/release/ alias matchString
        // was removed on 2026-09-07 as dead code (every definition migrated;
        // the alias is never pinned, its objects are rewritten after release,
        // triage/LOG.md 2026-07-26).
      ],
      depNameTemplate: "grafana/grafana",
      datasourceTemplate: "github-releases",
      // Our pin is unprefixed (13.0.4); upstream tags its releases v13.0.4.
      // The optional `+security-NN` tail matters: grafana ships out-of-band
      // fixes as semver build metadata (v13.0.1+security-01), and anchoring at
      // the patch digit would discard every one of them before Renovate ever
      // compared versions. Still strict enough to reject grafana's stray
      // `vtest-new-release-pipeline` tag.
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+(?:\\+security-\\d+)?)$",
      // Plain semver IGNORES build metadata for precedence, so
      // 13.0.1+security-01 would not rank above 13.0.1 and a security release
      // would read as "up to date". Regex versioning fixes the ordering by
      // mapping the security counter onto a fourth release component.
      // The group MUST be `build`, not `revision`: renovate's regex versioner
      // only appends `revision` when `build` is also present
      // (modules/versioning/regex/index.js).
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\+security-(?<build>\\d+))?$",
    },
    {
      // The version+sha256 pin scripts (Req 7.5, 7.6): the two CVE scanners
      // the gate itself runs on (install-scanners.sh — they used to arrive by
      // `curl .../main/install.sh | sudo sh`, unpinned, from a mutable branch,
      // as root) and the other workflow-installed binaries, kind and kyverno
      // (install-tool.sh — formerly version-pinned but never verified, kyverno
      // by curl piped into tar). One pin-block shape in both files, one
      // manager reading it.
      //
      // This manager is not optional garnish: a pinned scanner nobody bumps
      // stops detecting new advisories and says nothing while it does — and
      // kyverno has the same property one layer up, as the policy engine
      // behind the Req 4.6 gate. Pinning WITHOUT tracking trades a
      // supply-chain risk for a silent-staleness one, so 7.5 and 7.6 only
      // make sense together.
      customType: "regex",
      managerFilePatterns: ["/^scripts/install-(scanners|tool)\\.sh$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\\w+_VERSION=\"(?<currentValue>[^\"]+)\"",
      ],
      // Both projects tag releases v-prefixed; the pins are bare so the URL
      // template can add the `v` itself and the asset names (which are bare)
      // stay derivable from one variable.
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      // NO postUpgradeTask, unlike the definition managers above — deliberate.
      // Renovate bumps the version and leaves the sha256 behind, so the bump PR
      // fails its own scan step on a checksum mismatch until a human records the
      // new digest. That is the intended friction: an auto-recomputed checksum
      // is whatever upstream serves at that instant, which is a hash of the
      // thing rather than a decision about it.
      //
      // What the pin actually protects against is re-publication of a version
      // we already adopted (CVE-2026-33634's shape), and that holds in every
      // design here, because the digest only moves when the version does. These
      // also never automerge: that rule is scoped to github-tags, and this
      // manager is github-releases.
      //
      // Four tools, a handful of bumps a year each. Cheap enough to keep
      // manual.
    },
    {
      // Workflow-installed tools whose checksum control is NOT a digest in
      // this repo (Req 7.5, 7.6): govulncheck compiles from the module proxy
      // under the Go sumdb (build.yml), and the renovate/json5 test installs
      // are verified by npm against registry integrity hashes (validate.yml).
      // Their pins are workflow env vars — `NAME_VERSION: value` under the
      // same `# renovate:` comment convention the pin scripts use, YAML
      // assignment instead of shell.
      //
      // No extractVersionTemplate, unlike the pin-script manager: these pins
      // are written in each datasource's native format (go: v-prefixed,
      // npm: bare), so tags and pins already compare directly.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\\w+_VERSION:\\s*[\"']?(?<currentValue>[^\\s\"']+)",
      ],
      // A renovate major (41 → 44 is real today) stages behind Dependency
      // Dashboard approval like every other major, via the Req 3.4 rule below.
    },
    {
      // Chart image pins, digest-keyed spelling (Req 4.2, 7.6; task 8.7):
      // cert-manager's three images and hardened-app's baked-in values carry
      // repository/tag/digest on separate keys. Until this manager existed
      // nothing read chart/, so the deployed pins silently fell behind what
      // the catalogue publishes — cert-manager a version, grafana two, valkey
      // and hardened-app behind on digest alone (issue #64). Tag AND digest
      // are both captured so a same-tag rebuild (digest drift) reaches the
      // chart too, not just version bumps.
      //
      // The docker datasource resolves ghcr.io/mm-weber/dhc/* anonymously —
      // the packages are public since go-live. A chart-pin PR trails its
      // definition bump by one main build (the image must publish before a
      // tag exists to bump to), and its values change triggers the e2e
      // upgrade path (Req 5.6), which is the gate that merges it.
      customType: "regex",
      managerFilePatterns: ["/^chart/.+/(config/values-hardened|values)\\.yaml$/"],
      matchStrings: [
        "repository:\\s*(?<depName>ghcr\\.io/mm-weber/dhc/[^\\s\"']+)\\s*\\n\\s*tag:\\s*\"?(?<currentValue>[^\\s\"'@]+)\"?\\s*\\n\\s*digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Chart image pins, tag@digest spelling (same task): grafana and valkey
      // charts compose registry/repository:tag themselves, so the digest rides
      // on the tag value and registry+repository sit on separate keys — depName
      // is composed from both. grafana moved OFF its chart's bare-hex `sha:`
      // field onto this spelling deliberately: Renovate writes digests as
      // `sha256:<hex>`, which would corrupt a bare-hex field, and the chart
      // strips a trailing `@sha…` from the tag for its version label
      // (_helpers.tpl), so upstream supports exactly this shape.
      customType: "regex",
      managerFilePatterns: ["/^chart/.+/(config/values-hardened|values)\\.yaml$/"],
      matchStrings: [
        "registry:\\s*\"?(?<registry>[^\\s\"']+)\"?\\s*\\n\\s*repository:\\s*\"?(?<repository>mm-weber/dhc/[^\\s\"']+)\"?\\s*\\n\\s*tag:\\s*\"?(?<currentValue>[^\\s\"'@]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      depNameTemplate: "{{{registry}}}/{{{repository}}}",
      datasourceTemplate: "docker",
    },
    {
      // CI python pins (Req 7.5, 7.6; issue #74): yamllint is the Req 7.2
      // gate, yamale is ct lint's Chart.yaml schema check, pyyaml/pathspec
      // are their pinned transitive deps — all installed with
      // `pip install --require-hashes` from .github/requirements-ci.txt.
      // Same contract as the pin-script manager above: Renovate bumps the
      // version and leaves the --hash set behind, so the bump PR fails its
      // install until a human records the new hashes. pip's own datasource
      // format is bare PEP 440, no extractVersionTemplate needed.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/requirements-ci\\.txt$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n(?<packageName>[A-Za-z0-9._-]+)==(?<currentValue>[0-9][^\\s\\\\]*)",
      ],
    },
    {
      // Fetch-phase Go module bumps inside definitions (`go/bump@v2` deps
      // lists), the between-releases CVE patch lane established 2026-09-02
      // (triage/LOG.md, CVE-2026-56854). A security pin must not go
      // invisible (Req 7.6): the marker names the module, the go datasource
      // tracks it, and minimal version selection makes the pin a floor the
      // next upstream release retires (the release PR is the reminder to
      // drop the step). Go module versions carry their v, same as the
      // GOVULNCHECK_VERSION pin above; no extractVersion needed.
      customType: "regex",
      managerFilePatterns: ["/^image/.+/image\\.yaml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*-\\s*\\S+@(?<currentValue>v[^\\s\"']+)",
      ],
    },
    {
      // Chart versions tracked (Req 3.11; task 11.4). The three upstream
      // charts are pinned by hand in chart/<name>/chart.yaml, and until this
      // manager nothing read them, so the templates could trail the image
      // pins by releases (chart/cert-manager's own comment recorded the gap).
      // upstream.repository is captured as the registryUrl: the helm
      // datasource's default registry is charts.helm.sh/stable, a frozen
      // decoy that would report every chart up to date forever (independent
      // review 1.8). valkey's index url 301-redirects and the datasource
      // follows it (measured). hardened-app's own Chart.yaml differs by case
      // and is not captured: it is ours, not an upstream pin. A chart bump
      // is never automerged (the rule below): its values change runs the e2e
      // upgrade path (Req 5.6) and a human reads that verdict, since a chart
      // release can change what the values mean; grafana's version-skew note
      // in its chart.yaml governs that review.
      customType: "regex",
      managerFilePatterns: ["/^chart/.+/chart\\.yaml$/"],
      matchStrings: [
        "upstream:\\s*\\n\\s*name:\\s*(?<depName>[^\\s\"']+)\\s*\\n\\s*repository:\\s*(?<registryUrl>https?://[^\\s\"']+)\\s*\\n\\s*version:\\s*\"?(?<currentValue>[^\\s\"'#]+)",
      ],
      datasourceTemplate: "helm",
    },
  ],

  packageRules: [
    {
      // Req 3.3: the three cert-manager images share one upstream monorepo —
      // group their bumps into a single PR so one version moves all of them.
      matchDepNames: ["cert-manager/cert-manager"],
      groupName: "cert-manager monorepo",
    },
    {
      // Req 3.3: image/valkey/ and image/valkey-compat/ are the same build from
      // the same source pin, differing by one package. A bump has to move both
      // or the compat image stops being the runtime image plus a shell.
      //
      // Renovate's default branch topic would most likely group them anyway —
      // one depName, one new value, one branch. Stated rather than inherited,
      // for the same reason the cert-manager rule above is: the grouping is a
      // requirement, and a default that happens to satisfy it today is not a
      // record of that.
      matchDepNames: ["valkey-io/valkey"],
      groupName: "valkey runtime and compat",
    },
    {
      // Req 3.3, one layer down: the three cert-manager chart pins are the
      // same upstream release, so their chart-side bumps move as one PR too —
      // three separate PRs would each fail the e2e upgrade path against a
      // half-bumped trio.
      matchDepNames: [
        "ghcr.io/mm-weber/dhc/cert-manager-controller",
        "ghcr.io/mm-weber/dhc/cert-manager-webhook",
        "ghcr.io/mm-weber/dhc/cert-manager-cainjector",
      ],
      groupName: "cert-manager chart pins",
    },
    {
      // Req 3.4: a new major stages behind Dependency Dashboard approval
      // instead of opening an automatic PR.
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // The grafana definition tracks a minor line ("Grafana 13.1.x"), and a
      // patch release on that line is the fix lane for a between-releases
      // finding (Req 6.5). Without this, one branch per major carried every
      // 13.x update, so the open 13.2.0 minor PR swallowed the 13.1.5
      // security patch and no PR ever offered it (measured 2026-09-02, the
      // day grafana shipped 13.1.5 / 13.2.1 together). Patch and minor now
      // travel as separate PRs; the minor still stages behind the gate.
      matchDepNames: ["grafana/grafana"],
      separateMinorPatch: true,
    },
    {
      // Req 3.7 (task 11.1; design decision 8): quarantine. A third-party
      // release is not offered until it has aged three days, and a release
      // Renovate cannot date waits rather than passes. Independence from an
      // upstream compromise comes from three declared things: age (this
      // rule), signal (the authenticity class each definition declares and
      // the refresh verifies, Req 1.10, 3.8) and gates (the required checks).
      // Age answers the fast-burn record: ua-parser-js lived four hours,
      // chalk/debug two, the tj-actions and trivy tag repointings days; three
      // days is npm's unpublish window, and renovate itself, the
      // highest-privilege pin here, ages in the same ecosystem. The commit sha
      // a from-source bump records is pinned at bump time, so a tag rewritten
      // after the wait cannot move what was merged (review F2 c). Every
      // third-party version datasource is listed; no matchUpdateTypes, so
      // minors and majors age too. docker is deliberately absent: it carries
      // the catalogue's own published digests, which must reach the charts
      // the day they are published, and the hand-reviewed build layer.
      matchDatasources: ["github-tags", "github-releases", "npm", "pypi", "helm", "go"],
      minimumReleaseAge: "3 days",
      minimumReleaseAgeBehaviour: "timestamp-required",
    },
    {
      // Req 3.5, the decided scope stated: patch and digest updates of a
      // compile-from-source upstream (the github-tags datasource: cert-manager,
      // valkey, hardened-app) automerge behind green required checks. Nothing
      // else does: a repackage bump (grafana, github-releases) swaps a binary
      // we did not build and is reviewed even on a patch (its own rule below);
      // a tool pin (github-releases) needs the human half of its checksum
      // (Req 7.5); the build layer (docker) changes build behaviour (below);
      // minors and majors of any upstream are reviewed. Renovate withholds
      // the merge until the required checks pass, and the quarantine above
      // has already aged the release.
      matchDatasources: ["github-tags"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    {
      // Req 3.2: Renovate bumps only the source ref; this recomputes the
      // checksum and regenerates every version-derived field (vars, tags,
      // ldflags) so the bumped definition is coherent. Scoped to github-tags
      // so docker digest bumps don't trigger it. The command is allowlisted in
      // renovate.yml via RENOVATE_ALLOWED_POST_UPGRADE_COMMANDS (self-hosted).
      matchDatasources: ["github-tags"],
      postUpgradeTasks: {
        commands: ["scripts/refresh-definition.sh {{{packageFileDir}}}"],
        fileFilters: ["image/**/image.yaml"],
        executionMode: "update",
      },
    },
    {
      // The repackage counterpart (ADR 0002): Renovate bumps only the version
      // inside the tarball url, so this re-pins both per-arch checksums from
      // dl.grafana.com and regenerates the version-derived fields. Scoped by
      // name, not by datasource: the pinned tools in scripts/install-*.sh are
      // github-releases too, and keyed on the datasource this task ran on
      // their branches (measured 2026-09-02: a kyverno rebase executed
      // "refresh-grafana.sh scripts", failed, and the failed-artifact status
      // write aborted the whole run). Allowlisted alongside
      // refresh-definition.sh in renovate.yml.
      matchDepNames: ["grafana/grafana"],
      postUpgradeTasks: {
        commands: ["scripts/refresh-grafana.sh {{{packageFileDir}}}"],
        fileFilters: ["image/**/image.yaml"],
        executionMode: "update",
      },
      // Explicit, though the Req 3.5 automerge rule above is github-tags-only:
      // a repackage bump swaps a binary artifact we did not build and re-pins
      // its checksum, so it is always reviewed even on a patch.
      automerge: false,
    },
    {
      // Req 3.11: a chart release reaching a chart is reviewed, never
      // automerged. Explicit, though no automerge rule reaches the helm
      // datasource: the scope is a requirement, and a default that happens
      // to satisfy it today is not a record of that.
      matchDatasources: ["helm"],
      automerge: false,
    },
    {
      // Req 3.12: a same-tag rebuild moves the digest under a chart's image
      // pin (task 9.2's publish-on-change), and that bump is the catalogue's
      // own published image reaching its chart. It automerges behind the
      // required checks, the e2e gate among them since 2026-08-21. A tag
      // bump of the same pin (a new release reaching the chart) stays
      // reviewed. The build-layer rule below is ordered after this one so
      // its automerge: false wins for the build layer, which is docker too.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/mm-weber/dhc/**"],
      matchUpdateTypes: ["digest"],
      automerge: true,
    },
    {
      // The build layer is our own stricter pin surface — a frontend/builder
      // change alters build behavior, so it is always reviewed, never merged
      // automatically. Grouped for a tidy dashboard.
      matchDatasources: ["docker"],
      matchPackageNames: ["dhi.io/build", "dhi.io/golang"],
      groupName: "dhi.io build layer",
      automerge: false,
    },
  ],
}
